---
import { skills } from '../utils/skillsData.ts';
import { works } from '../utils/worksDatos';
---
<body>
    <section class="hero">
        <div>
            <p class="info">OS: norstack OS 3</p>
            <p class="info">REF_SIS: ANGELO_V3.0</p>
            <p class="info">ARCH: FULLSTACK_CLOUD</p>
        </div>
        <div class="description">
            <p class="tag">[ 00 / PORTFOLIO ]<p>
            <h1>ANGELO</h1>
            <div class="state">
                <p>Fullstack Developer & Cloud Solution Architect focused on user-centric performance and scalable digital systems.</p>
                <p>Expertise across frontend and backend development, cloud computing, DevOps and automation. Passionate about optimizing workflows, hardening security and building robust, cost-efficient solutions.</p>
            </div>
        </div>
        <div class="card">
            <div class="sides">
                <div class="card-face card-front">
                    <picture>
                        <img src="/angelo.jpg" alt="foto">
                    </picture>
                    <p>Subject: Angelo // AWS_DEV</p>
                </div>
                <div class="card-face card-back">
                    <p>hola</p>
                </div>
            </div>
        </div>
    </section>
    <section class="skills">
        <div>
            <h2>STACK</h2>
            <h2>INDEX</h2>
            <p>Specimen A: technologies utilized for production environments.</p>
            <!-- <ul class="etiquetas">
                <li>Frontend</li>
                <li>Backend</li>
                <li>Database</li>
                <li>Cloud</li>
                <li>Tools</li>
                <li>Operation System</li>
                <li>Microcontrollers</li>
            </ul> -->
        </div>
        <div class="stack">
            {
                skills?.map((skill, index) => {
                    return (
                        <section data-index={index}>
                            <p>{skill.tipo}</p>
                            <h2>{skill.name}</h2>
                        </section>
                    );
                })
            }
        </div>
    </section>
    <section class="experience">
        <div>
            <h2>Experience</h2>
            <p>LOG_DATA / 2023-2026</p>
        </div>
        <div>
            {
                works?.map((work,index)=>{
                    return (
                        <section class="trabajos" data-index={index}>
                            <section>
                                <h4>{work.num}</h4>
                                <div>
                                    <h3>{work.name}</h3>
                                    <p>{work.role}</p>
                                </div>
                            </section>
                            <p>{work.date}</p>
                        </section>
                    );
                })
            }
        </div>
    </section>
</body>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;500;700&display=swap');

    :root{
        --font-display: "Anton", sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, monospace;
        --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
        --ink: oklch(0.19 0 0);
        --contrast: oklch(98.288% 0.00104 11.251);
        --secondary: #023e8a;
    }

    body {
        font-family: var(--font-display);
        background-color: oklch(0.964 0.004 106);
        background-image: 
        repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.03) 3px),
        repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0,0,0,0.03) 3px);
    }
    .hero {
        width: 100%;
        height: 100vh;
        padding: 20px 80px;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        perspective: 1000px;
    }
    .hero div:first-child {
        
    }
    .info {
        font-family: var(--font-mono);
        direction: rtl;
        font-weight: 300;
        font-size: clamp(0.5rem,0.8rem,1rem);
    }
    .hero h1 {
        font-size: clamp(9rem, 12rem, 15rem);
        color: var(--ink);
        font-weight: 700;
        letter-spacing: 1.5%;
        line-height: 1.05;
    }
    .tag {
        color: var(--secondary);
    }
    .state {
        display: flex;
        flex-direction: row;
        gap: 20px;
        padding-left: 20px;
        border-left: 6px solid;
        border-left-color: var(--secondary);
        width: 70%;
    }
    .state p:first-child {
        font-family: var(--font-display);
        font-size: clamp(1.2rem,1.6rem,2rem);
        font-weight: 200;
        width: 50%;
    }
    .state p:last-child {
        font-family: var(--font-mono);
        font-weight: 300;
        font-size: clamp(0.6rem,1rem,1.6rem);
        width: 50%;
    }
    .card{
        position: absolute;
        top: 18%;
        left: 45%;
        rotate: 6deg;
        width: 240px;
        aspect-ratio: 3/4;
        border: 2px solid var(--ink);
        background-color: var(--secondary);
        box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
        transform-style: preserve-3d;
        cursor: pointer;
    }
    .sides {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s ease-in-out;
    }
    .card-face {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        overflow: hidden;
    }
    .card-back {
        transform: rotateY(180deg);
    }
    .card picture {
        display: block;
        width: 100%;
    }
    .card img {
        display: block;
        width: 100%;
        height: 280px;
        object-fit: cover;
    }
    .card p {
        font-family: var(--font-mono);
        color: var(--contrast);
        padding: 10px 0;
        text-align: center;
        font-weight: 400;
        font-size: 0.7rem;
        text-transform: uppercase;
    }
    .skills {
        display: flex;
        flex-direction: row;
        border-top: 2px solid black;
        border-bottom: 2px solid black;
        padding-left: 80px;
    }
    .skills div:first-child {
        width: 25%;
        padding: 20px 0;
    }
    .skills div:first-child h2 {
        font-size:2.4rem;
    }
    .skills div:first-child h2:first-child {
        line-height:1;
    }
    .skills div:first-child p {
        font-size:1rem;
        font-family: var(--font-mono);
        text-transform: uppercase;
    }
    .skills div:last-child {
        width: 80%;
        border-left: 1px solid black;
    }
    .stack {
        display: grid;
        grid-template-columns: auto auto auto auto;
    }
    .stack section {
        padding:40px 20px;
        border-bottom: 1px solid black;
        border-right: 1px solid black;
    }
    .stack section:hover {
        background-color: var(--secondary);
        color: var(--contrast);
    }
    .stack p {
        font-family: var(--font-mono);
        font-size: 0.8rem;
    }
    .stack h2 {
        font-size:1.2rem;
        font-weight: 500;
    }
    /* .etiquetas {
        display: flex;
        flex-direction: row;
        gap:10px;
        font-family: var(--font-mono);
        text-transform: uppercase;
        font-size:0.6rem;
        padding:10px 0;
    }
    .etiquetas li {
        border-radius: 20%;
        color: var(--secondary);
        border: 0.6px solid var(--secondary);
        text-align: center;
    } */
    .experience {
        padding: 40px 80px;
    }
    .experience div:first-child {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: baseline;
        padding-bottom: 30px;
        border-bottom: 2px solid black;
    }
    .experience div:first-child h2 {
        font-size: 6rem;
        font-weight: 700;
    }
    .experience div:first-child p {
        font-family: var(--font-display);
        color: rgb(83, 83, 83);
    }
    .trabajos {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: baseline;
        padding: 40px 10px;
        border-bottom: 0.5px solid darkgray;
        transition-property: all;
        transition-timing-function: cubic-bezier(.4, 0, .2, 1) ;
        transition-duration: .15s;
    }
    .trabajos section {
        display: flex;
        flex-direction: row;
        gap: 20px;
    }
    .trabajos section h4{
        font-family: var(--font-mono);
        font-size: 500;
        font-size: 1.5rem;
    }
    .trabajos section h3{
        font-size: 700;
        font-size: 1.5rem;
    }
    .trabajos p {
        font-family: var(--font-mono);
        font-size: .875rem;
        opacity: .7;
    }
    .trabajos:hover {
        background-color: var(--ink);
        color: var(--contrast);
    }
</style>

<script>
    import { gsap } from "gsap";
    import {TextPlugin} from "gsap/TextPlugin";

    gsap.registerPlugin(TextPlugin);

    const decodeChars = "*-$%&#!/()*-_}{+";

    document.querySelectorAll<HTMLElement>(".info").forEach((element, index) => {
        const originalText = element.textContent ?? "";
        const scrambledText = originalText.replace(/\S/g, () =>
            decodeChars[Math.floor(Math.random() * decodeChars.length)]
        );

        gsap.set(element, { text: scrambledText });
        gsap.to(element, {
            duration: 0.8,
            text: {
                value: originalText,
                speed: 0.3,
            },
            ease: "none",
        });
    });

    const card: HTMLElement | null = document.querySelector('.card');

    card?.addEventListener('mouseenter', () => {
        gsap.to(card, { duration: 0.6, rotationY: 180, ease: "power1.inOut" });
    });
    

    card?.addEventListener('mouseleave', () => {
        gsap.to(card, { duration: 0.6, rotationY: 0, ease: "power1.inOut"});
    });
</script>